<section class="section">
  <div class="container">

    <div class="row row--wrap">
      <div class="col col--7">
        <article class="article">
          <div class="badge">Headings</div>
          <h1>H1 Page Title</h1>
          <h2 class="title title--section">H2 Subheading Text</h2>
          <h3>H3 Subheading Text</h3>
          <h4>H4 Subheading Text</h4>
          <h5>H5 Subheading Text</h5>
          <h6>H6 Subheading Text</h6>
        </article>

        <article class="article">
          <div class="badge">Body</div>
          <p class="deck">Deck text. A deck appears after a title and serves to explain the title or clarify its meaning.</p>

          <p class="lead">Lead text. Articles often begin with a paragraph that is larger than the body copy. This becomes an entry point for the content.</p>

          <p>Just some normal sized text. This style is the default style for a paragraph. It should be easy to read for long form copy.</p>

          <p class="small">This text is smaller than body paragraph text. This style may be used for an aside, a note, or a card summary.</p>

          <p><a href="/">Hyperlink Text Style</a></p>
        </article>

        <article class="article">
          <div class="badge">Dividers</div>
          <hr>
          <hr class="divider">
        </article>

      </div><!--end col-->

      <div class="col">
        <article class="article">
          <div class="badge">Brand</div>
          <div class="row row--wrap">

            <div class="swatch swatch--color-brand-primary">
              <span class="swatch__label">
                Brand Primary
              </span>
            </div>

            <div class="swatch swatch--color-brand-secondary">
              <span class="swatch__label">
                Bramd Secondary
              </span>
            </div>

            <div class="swatch swatch--color-brand-tertiary">
              <span class="swatch__label">
                Brand Tertiary
              </span>
            </div>
          </div>
        </article>

        <article class="article">
          <div class="badge">System</div>
          <div class="row row--wrap">
            <div class="swatch swatch--color-bg">
              <span class="swatch__label">
                Background
              </span>
            </div>
          </div><!--end row-->

          <div class="row row--wrap">
            <div class="swatch swatch--color-fg">
              <span class="swatch__label">
                Foreground
              </span>
            </div>

            <div class="swatch swatch--color-fg-subdued">
              <span class="swatch__label">
                Foreground Subdued
              </span>
            </div>
          </div><!--end row-->

          <div class="row row--wrap">
            <div class="swatch swatch--color-border">
              <span class="swatch__label">
                Border
              </span>
            </div>

            <div class="swatch swatch--color-border-subdued">
              <span class="swatch__label">
                Border Subdued
              </span>
            </div>
          </div><!--end row-->

          <div class="row row--wrap">
            <div class="swatch swatch--color-accent">
              <span class="swatch__label">
                Accent
              </span>
            </div>
          </div><!--end row-->
        </article>

      </div><!--end col-->
    </div><!--end row-->
  </div>
</section>